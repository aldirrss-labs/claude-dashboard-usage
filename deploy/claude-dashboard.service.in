# Template, not a usable unit file. The @TOKENS@ are filled in by
# deploy/install.sh, which reads them from the machine it runs on:
# the repo's own location, whichever node is on PATH, and the chosen port.
#
# It is a template rather than a committed unit because the two values that
# matter most — where the repo lives and where node lives — differ on every
# machine, and a hardcoded guess silently produces a service that starts and
# then fails, rather than an error you can see.

[Unit]
Description=Claude Code Usage Dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=@WORKING_DIRECTORY@
ExecStart=@NODE_BIN@ server.js
Environment=PORT=@PORT@
Environment=HOSTNAME=@HOST@
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5
# Next.js exits 143 (128+SIGTERM) on a normal stop; without this systemd logs
# every `systemctl --user stop/restart` as a failure.
SuccessExitStatus=143

[Install]
WantedBy=default.target
